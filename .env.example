PORT=7500
APP_ENV=development
DATABASE_URL=testurl
CLEANUP_INTERVAL_MINUTES=1440

# Auth
APP_API_KEY=your-api-key-here
APP_ALLOWED_EMAIL=you@example.com
APP_COOKIE_SECRET=your-cookie-secret-here
APP_SKIP_CLOUDFLARE_AUTH=true

# Cloudflare Access (required in production when APP_SKIP_CLOUDFLARE_AUTH is not set)
CLOUDFLARE_TEAM_DOMAIN=
CLOUDFLARE_AUDIENCE=
