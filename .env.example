PORT=7500
APP_ENV=development
DATABASE_URL=local-db-url
# Production DB (used for prod migrations via Makefile)
PROD_DATABASE_URL=prod-db-url
# for local Dev - Docker compose POSTGRES
POSTGRES_DB=ephermal_bridge
POSTGRES_USER=your-user
POSTGRES_PASSWORD=your-password
R2_ACCESS_KEY_ID=get-from-Cloudflare
R2_SECRET_ACCESS_KEY=get-from-Cloudflare
R2_ACCOUNT_ID=get-from-Cloudflare
R2_BUCKET_NAME=get-from-Cloudflare
R2_TOKEN_VALUE=get-from-Cloudflare
R2_S3_API=get-from-Cloudflare
#DB cleanup
CLEANUP_INTERVAL_MINUTES=1440
# Auth
APP_API_KEY=your-own-api-key
APP_ALLOWED_EMAIL=your-email
APP_COOKIE_SECRET=super-secret
APP_SKIP_CLOUDFLARE_AUTH=true # true for local, false for prod

# Cloudflare Access (required in production when APP_SKIP_CLOUDFLARE_AUTH is not set)
CLOUDFLARE_TEAM_DOMAIN=get-from-Cloudflare
CLOUDFLARE_AUDIENCE=get-from-Cloudflare

CORS_ALLOWED_ORIGINS=https://yourfrontend.com,http://localhost:5173

